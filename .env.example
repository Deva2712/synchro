# Copy to .env and fill in. Never commit .env - it is git-ignored on purpose.

# --- storage -------------------------------------------------------------
# SQLite runs with zero setup. For the PostgreSQL path start docker-compose and use:
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# --- security ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_TTL_MIN=60
RATE_LIMIT_PER_MIN=120
CORS_ORIGINS=http://localhost:5173

# Bootstrap accounts. If a password is left blank one is generated and printed
# to the API log at first start.
SEED_ADMIN_EMAIL=admin@sentinel.local
SEED_ADMIN_PASSWORD=
SEED_ANALYST_EMAIL=analyst@sentinel.local
SEED_ANALYST_PASSWORD=

# --- AI layer ------------------------------------------------------------
# LLM_BACKEND=anthropic uses ANTHROPIC_API_KEY; LLM_BACKEND=bedrock uses the
# AWS credential chain (role, profile or env). Keys are never read from code.
LLM_BACKEND=anthropic
LLM_MODEL=claude-opus-5
LLM_ENABLED=auto
LLM_TIMEOUT_S=20
# ANTHROPIC_API_KEY=
# AWS_REGION=ap-south-1

# --- decision policy (risk-team tunable, no redeploy needed) --------------
W_ML=0.55
W_ANOMALY=0.20
W_RULES=0.25
T_STEP_UP=0.35
T_REVIEW=0.60
T_BLOCK=0.85
